# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---- MongoDB Atlas (company account) ----
# Atlas -> Connect -> Drivers -> Node.js. Use the readWrite database user.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Central database the Next.js app will use (built later from the mirror).
MONGODB_DB=sukhsa_central

# Raw, untouched copy of Firestore. The migration writes ONLY here.
MONGODB_MIRROR_DB=firestore_mirror

# ---- Firebase (source, read-only use) ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Save the JSON in ./secrets/ (git-ignored) and point to it here.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=gen-lang-client-0550725378
FIRESTORE_DATABASE_ID=ai-studio-gatelogattendanc-c0c8afef-ced2-4d9f-99a4-574f8ceed53d

# Admin emails that get the super_admin role in the central users collection.
SUPER_ADMIN_EMAILS=

# Comma-separated root collections to skip. guard_sessions are short-lived login tokens.
MIGRATE_EXCLUDE=guard_sessions
